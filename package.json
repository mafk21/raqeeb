  "engines": { "node": ">=18" },
  "keywords": ["claude-code", "ai-agents", "dashboard", "developer-tools", "local-first"],
  "repository": { "type": "git", "url": "git+https://github.com/mafk21/raqeeb.git" },
  "homepage": "https://github.com/mafk21/raqeeb",
